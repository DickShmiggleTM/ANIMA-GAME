; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows this.

config_version=5

[application]

config/name="ANIMA"
config/description="AI-first spiritual successor to Creatures. Autonomous Zoi agents powered by RL, ECS biochemistry, and emergent social dynamics."
config/version="0.1.0"
config/tags=PackedStringArray("simulation", "alife", "ai", "android")
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/textures/icon.svg"

[autoload]

AnimaCore="*res://scripts/autoload/anima_core.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"
WorldManager="*res://scripts/world/world_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[input]

touch_tap={
"deadzone": 0.5,
"events": [Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":-1,"index":0,"position":Vector2(0, 0),"canceled":false,"pressed":false,"double_tap":false,"script":null)]
}

[android]

modules="org/godotengine/anima/AnimaCorePlugin"

[debug]

gdscript/warnings/enable=true
gdscript/warnings/exclude_addons=true
